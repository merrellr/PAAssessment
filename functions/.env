# Non-secret function config, loaded automatically by Firebase Functions v2.
# GROQ_API_KEY is NOT here — it's a secret, set separately with:
#   firebase functions:secrets:set GROQ_API_KEY
#
# To change the model without a code edit: update the line below, then
# redeploy (firebase deploy --only functions:gradeApplicationScenario).
# Check console.groq.com/docs/models first — Groq's free-tier lineup
# shifts periodically.
GROQ_MODEL=openai/gpt-oss-120b
