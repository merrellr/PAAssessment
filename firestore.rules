// Firestore rules for project product-advisory-lms.
//
// STATUS: the company-accounts rules (through checkpoint 7) are published. The
// tool roadmap rules at the very bottom (tools, toolVotes, toolSuggestions) are
// NEW and only take effect once this whole file is pasted into the console
// Rules tab and published. Update this status line when that is done.
//
// Editing this file does NOT change the live rules. Paste the whole file into
// the console Rules tab and click Publish, so the two stay identical. These
// rules are tested against the local Firestore emulator (see
// tests/firestore-rules.test.mjs).
//
// WHO CAN DO WHAT
//   Anyone signed in:   read/write/delete ONLY their own progress/{uid}.
//   Platform owner:     (an account with a platformAdmins/{uid} document,
//                       created by hand in the console) creates and edits
//                       companies, creates and revokes invites, reads every
//                       membership, and can end any membership. Nobody can
//                       delete a company.
//   Company admin:      (an ACTIVE membership with role "admin") reads their
//                       own company, creates and revokes its invites, reads
//                       its memberships, may change ONLY its focusAreas, and
//                       can end anyone's membership but its own (see memberships).
//   Invited person:     reads an invite if they know its secret link, then
//                       accepts it, which creates their own membership.
//   Active member:      writes their own shared record (orgs/{orgId}/members/
//                       {uid}) for their current company; company admins and
//                       the platform owner can read it, nobody else can.
//   Weekly snapshots:   (orgs/{orgId}/snapshots) numbers-only records of a
//                       company's progress for the trend in its report. Company
//                       admins and the owner read and add them; one per day,
//                       never changed or deleted.
//   Pilot tracker:      (orgPilot/{orgId} and its log) stage, dates, goals, run-book
//                       ticks and private notes for each company. Platform owner
//                       only; company admins can never read it.
//   Company focus list: a copy of the company's ranked focus areas that its
//                       active members can read (see orgFocus below).
//   Tool roadmap:       anyone can read the list of tools and their vote counts.
//                       A signed-in person with a verified email can back up to 3
//                       tools (one vote each), and suggest a tool. Only the
//                       platform owner manages the tools and reviews suggestions.
//   Everything else is denied by default.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    function myMembership() {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data;
    }

    function isActiveAdminOf(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && myMembership().orgId == orgId
        && myMembership().role == 'admin'
        && myMembership().status == 'active';
    }

    // ---------------------------------------------------------------- progress
    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ----------------------------------------------------------- platformAdmins
    // Lets a signed-in person check whether THEIR OWN account is the platform
    // owner. Nobody can list these documents or write them from the app.
    match /platformAdmins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------------- orgs
    function validOrg(d) {
      return d.keys().hasOnly(['name', 'plan', 'seatLimit', 'focusAreas', 'notes',
          'contactName', 'contactEmail', 'contactPhone', 'billingAddress',
          'status', 'createdAt', 'createdBy', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.plan in ['flat', 'seat']
        && (d.seatLimit == null || (d.seatLimit is int && d.seatLimit >= 1 && d.seatLimit <= 100000))
        && d.focusAreas is list && d.focusAreas.size() <= 7
        && d.focusAreas.hasOnly(['discovery', 'strategy', 'prioritization', 'execution', 'stakeholder', 'aiIndividual', 'aiOrg'])
        && d.focusAreas.toSet().size() == d.focusAreas.size()
        && d.get('notes', '') is string && d.get('notes', '').size() <= 2000
        && d.get('contactName', '') is string && d.get('contactName', '').size() <= 100
        && d.get('contactEmail', '') is string && d.get('contactEmail', '').size() <= 254
        && d.get('contactPhone', '') is string && d.get('contactPhone', '').size() <= 40
        && d.get('billingAddress', '') is string && d.get('billingAddress', '').size() <= 500
        && d.status in ['active', 'archived'];
    }

    match /orgs/{orgId} {
      allow read: if isPlatformOwner() || isActiveAdminOf(orgId);
      allow create: if isPlatformOwner()
        && validOrg(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isPlatformOwner()
          && validOrg(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy)
        || (isActiveAdminOf(orgId)
          && validOrg(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['focusAreas', 'updatedAt']));
      allow delete: if false;
    }

    // ----------------------------------------------------------------- invites
    // The document id IS the secret token in the invite link. Anyone signed in
    // who knows a token can read that one invite (listing is not allowed).
    function validInvite(d) {
      return d.keys().hasOnly(['orgId', 'orgName', 'email', 'name', 'phone', 'role', 'status', 'createdAt', 'createdBy', 'expiresAt', 'usedBy', 'usedAt'])
        && d.get('name', '') is string && d.get('name', '').size() <= 100
        && d.get('phone', '') is string && d.get('phone', '').size() <= 40
        && d.orgId is string
        && d.orgName is string && d.orgName.size() > 0 && d.orgName.size() <= 100
        && d.email is string && d.email.size() > 0 && d.email.size() <= 254
        && d.role in ['member', 'admin']
        && d.status == 'open'
        && d.usedBy == null && d.usedAt == null
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt < request.time + duration.value(120, 'd');
    }

    match /invites/{token} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isPlatformOwner() || isActiveAdminOf(resource.data.orgId));

      allow create: if (isPlatformOwner() || isActiveAdminOf(request.resource.data.orgId))
        && validInvite(request.resource.data)
        && get(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)).data.status == 'active'
        && get(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)).data.name == request.resource.data.orgName;

      allow update: if isSignedIn() && (
        // 1. The owner or one of the company's admins revokes an open invite.
        ((isPlatformOwner() || isActiveAdminOf(resource.data.orgId))
          && resource.data.status == 'open'
          && request.resource.data.status == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        ||
        // 2. The person accepting it, in the same batch that creates their membership.
        (resource.data.status == 'open'
          && request.time < resource.data.expiresAt
          && request.resource.data.status == 'used'
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.usedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt'])
          && getAfter(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.inviteToken == token)
      );

      allow delete: if false;
    }

    // ------------------------------------------------------------- memberships
    // One document per person (their uid), holding their CURRENT company
    // membership. A removed member can join a new company by accepting a new
    // invite, which rewrites the document.
    function validJoin(d, uid) {
      return d.keys().hasOnly(['orgId', 'orgName', 'role', 'status', 'inviteToken', 'joinedAt', 'endedAt', 'email', 'displayName', 'phone'])
        && d.get('phone', '') is string && d.get('phone', '').size() <= 40
        && d.get('phone', '') == get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.get('phone', '')
        && d.orgId is string
        && d.orgName is string
        && d.role in ['member', 'admin']
        && d.status == 'active'
        && d.endedAt == null
        && d.joinedAt == request.time
        && d.inviteToken is string
        && d.email is string && d.email == request.auth.token.email.lower()
        && d.displayName is string && d.displayName.size() <= 100
        && get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.status == 'open'
        && get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.orgId == d.orgId
        && get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.orgName == d.orgName
        && get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.role == d.role
        && request.time < get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.expiresAt
        && getAfter(/databases/$(database)/documents/invites/$(d.inviteToken)).data.status == 'used'
        && getAfter(/databases/$(database)/documents/invites/$(d.inviteToken)).data.usedBy == uid
        && get(/databases/$(database)/documents/orgs/$(d.orgId)).data.status == 'active';
    }

    match /memberships/{uid} {
      allow get: if isSignedIn()
        && (request.auth.uid == uid || isPlatformOwner() || isActiveAdminOf(resource.data.orgId));
      allow list: if isSignedIn() && (isPlatformOwner() || isActiveAdminOf(resource.data.orgId));

      allow create: if isSignedIn() && request.auth.uid == uid
        && validJoin(request.resource.data, uid);
      allow update: if isSignedIn() && request.auth.uid == uid
        && resource.data.status == 'removed'
        && validJoin(request.resource.data, uid);
      // When someone deletes their account they blank the name, email and phone
      // on their membership record. Nothing else about it may change.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'phone'])
        && request.resource.data.email == ''
        && request.resource.data.displayName == ''
        && request.resource.data.get('phone', '') == '';
      // A membership is ended by the company, never by the member: the platform
      // owner or one of the company's admins can end anyone's membership but their
      // own. Only the status and end date change, so the person's record of who they
      // were and when they joined stays exactly as it was. From then on they can no
      // longer add to the company's copy of their results (see the shared-record
      // rules below), and they keep their own account, results and course access.
      allow update: if isSignedIn() && request.auth.uid != uid
        && (isPlatformOwner() || isActiveAdminOf(resource.data.orgId))
        && resource.data.status == 'active'
        && request.resource.data.status == 'removed'
        && request.resource.data.endedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt']);
      allow delete: if false;
    }

    // ------------------------------------------------- shared record per member
    // orgs/{orgId}/members/{uid} is the copy of a member's results that their
    // company can see. It holds ONLY: name and email, the latest assessment
    // (scores and individual answers), per-course lesson progress, and when
    // they were last active. It never holds private reflections, saved
    // templates, phone number or profile details.
    //
    // The member writes it, and only while their membership in THIS company is
    // active. When the membership ends, nothing can update it any more, so the
    // company keeps it exactly as it was. The only later change allowed is the
    // person blanking their own name and email (identity = null) when they
    // delete their account.
    function isActiveMemberOf(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && myMembership().orgId == orgId
        && myMembership().status == 'active';
    }

    function validShare(d) {
      return d.keys().hasOnly(['identity', 'assessment', 'courses', 'lastActiveAt', 'updatedAt'])
        && d.identity is map
        && d.identity.keys().hasOnly(['name', 'email'])
        && d.identity.name is string && d.identity.name.size() <= 100
        && d.identity.email is string && d.identity.email == request.auth.token.email.lower()
        && (d.assessment == null || d.assessment is map)
        && d.courses is map
        && (d.lastActiveAt == null || (d.lastActiveAt is string && d.lastActiveAt.size() <= 40))
        && d.updatedAt == request.time;
    }

    match /orgs/{orgId}/members/{uid} {
      // The company's admins and the platform owner can read it. The person
      // can read their OWN record too, so the app can show them exactly what
      // their company sees.
      allow read: if isPlatformOwner() || isActiveAdminOf(orgId)
        || (isSignedIn() && request.auth.uid == uid);

      // An archived company (for example one that has stopped paying) receives
      // nothing new: members' copies stop updating, exactly as if they had left.
      allow create, update: if request.auth.uid == uid
        && isActiveMemberOf(orgId)
        && get(/databases/$(database)/documents/orgs/$(orgId)).data.status == 'active'
        && validShare(request.resource.data);

      allow update: if request.auth.uid == uid
        && request.resource.data.identity == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['identity', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ------------------------------------------------------ company focus list
    // The company's ranked focus areas, copied from orgs/{orgId}.focusAreas into a
    // document that its ACTIVE MEMBERS may read (members cannot read the company
    // record itself, which holds contacts, billing and notes). The learner
    // dashboard uses it only to break ties between equally good recommendations.
    // It can only be written together with the company record: the rule below
    // refuses any copy that does not match the company's own list.
    match /orgFocus/{orgId} {
      allow get: if isPlatformOwner() || isActiveAdminOf(orgId) || isActiveMemberOf(orgId);

      allow create, update: if (isPlatformOwner() || isActiveAdminOf(orgId))
        && request.resource.data.keys().hasOnly(['focusAreas', 'updatedAt'])
        && request.resource.data.focusAreas is list
        && request.resource.data.focusAreas.size() <= 7
        && request.resource.data.focusAreas.hasOnly(['discovery', 'strategy', 'prioritization', 'execution', 'stakeholder', 'aiIndividual', 'aiOrg'])
        && request.resource.data.focusAreas.toSet().size() == request.resource.data.focusAreas.size()
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/orgs/$(orgId)).data.focusAreas == request.resource.data.focusAreas;

      allow delete: if false;
    }

    // ------------------------------------------------------------ activity log
    // A record of what the company's admins and the platform owner did: invites
    // created or withdrawn, people removed, priorities changed, details edited.
    // Entries are added by the person who did it (they cannot sign as somebody
    // else), carry the server's time, and can never be changed or deleted. The
    // company's admins and the owner read it; members cannot. It is kept by the
    // app on a best-effort basis, so it is an accountability aid, not a
    // tamper-proof legal record.
    match /orgs/{orgId}/audit/{entryId} {
      allow read: if isPlatformOwner() || isActiveAdminOf(orgId);
      allow create: if (isPlatformOwner() || isActiveAdminOf(orgId))
        && request.resource.data.keys().hasOnly(['action', 'actorUid', 'actorEmail', 'targetEmail', 'detail', 'at'])
        && request.resource.data.action in ['company.created', 'company.edited', 'company.archived', 'company.restored',
            'invite.created', 'invite.revoked', 'invite.renewed', 'member.removed', 'focus.changed']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email.lower()
        && request.resource.data.get('targetEmail', '') is string && request.resource.data.get('targetEmail', '').size() <= 254
        && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 300
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------- weekly snapshots
    // A small record of a company's numbers (how many people, how many took the
    // assessment, average scores) saved by the company dashboard at most once a
    // week, so the report can show a trend. Numbers only: no names or emails.
    // The id is the day (2026-10-13), so a day can only be written once, and a
    // snapshot can never be changed or deleted afterwards. The company's admins
    // and the owner read and add them; members cannot.
    function validSnapshot(d, day) {
      return d.keys().hasOnly(['day', 'at', 'people', 'assessed', 'learning', 'finished', 'inactive',
          'avgOverall', 'avgPlan', 'lessons', 'areas'])
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.day == day
        && d.at == request.time
        && d.people is int && d.people >= 0 && d.people <= 100000
        && d.assessed is int && d.assessed >= 0 && d.assessed <= d.people
        && d.learning is int && d.learning >= 0 && d.learning <= d.people
        && d.finished is int && d.finished >= 0 && d.finished <= d.people
        && d.inactive is int && d.inactive >= 0 && d.inactive <= d.people
        && (d.avgOverall == null || (d.avgOverall is int && d.avgOverall >= 0 && d.avgOverall <= 100))
        && (d.avgPlan == null || (d.avgPlan is int && d.avgPlan >= 0 && d.avgPlan <= 100))
        && d.lessons is int && d.lessons >= 0 && d.lessons <= 10000000
        && d.areas is map
        && d.areas.keys().hasOnly(['discovery', 'strategy', 'prioritization', 'execution', 'stakeholder', 'aiIndividual', 'aiOrg'])
        && areaOk(d.areas, 'discovery') && areaOk(d.areas, 'strategy') && areaOk(d.areas, 'prioritization')
        && areaOk(d.areas, 'execution') && areaOk(d.areas, 'stakeholder') && areaOk(d.areas, 'aiIndividual')
        && areaOk(d.areas, 'aiOrg');
    }

    function areaOk(areas, k) {
      return !(k in areas) || (areas[k] is int && areas[k] >= 0 && areas[k] <= 100);
    }

    match /orgs/{orgId}/snapshots/{day} {
      allow read: if isPlatformOwner() || isActiveAdminOf(orgId);
      allow create: if (isPlatformOwner() || isActiveAdminOf(orgId))
        && validSnapshot(request.resource.data, day);
      allow update, delete: if false;
    }

    // --------------------------------------------------- owner-only company notes
    // The platform owner's private notes about a company. They used to live on the
    // company record itself, which that company's admins can read, so they are
    // kept here where only the platform owner can.
    match /orgPrivate/{orgId} {
      allow get, list: if isPlatformOwner();
      allow create, update: if isPlatformOwner()
        && request.resource.data.keys().hasOnly(['notes', 'updatedAt'])
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ------------------------------------------------ owner-only pilot tracker
    // Where each company is on the way from prospect to customer: its stage, the
    // pilot dates and goals, the run-book items ticked off, and a private timeline
    // of notes. Only the platform owner can see or change any of it; company admins
    // never can.
    function dayOk(s) {
      return s is string && (s == '' || s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function goalOk(goals, i) {
      return goals.size() <= i
        || (goals[i] is map
          && goals[i].keys().hasOnly(['metric', 'target'])
          && goals[i].metric in ['joined_pct', 'assessed_pct', 'started_pct', 'finished_pct', 'plan_pct', 'quiet_pct', 'overall_gain']
          && goals[i].target is int && goals[i].target >= 0 && goals[i].target <= 100);
    }
    function validPilot(d) {
      return d.keys().hasOnly(['stage', 'pilotStart', 'pilotEnd', 'nextCheckin', 'renewalDate', 'baselineDay',
          'sponsor', 'pilotSize', 'goals', 'done', 'summaryNote', 'updatedAt'])
        && d.stage in ['prospect', 'pilot_planned', 'pilot_running', 'pilot_review', 'onboarding', 'active', 'closed']
        && dayOk(d.pilotStart) && dayOk(d.pilotEnd) && dayOk(d.nextCheckin) && dayOk(d.renewalDate) && dayOk(d.baselineDay)
        && d.sponsor is string && d.sponsor.size() <= 100
        && d.pilotSize is int && d.pilotSize >= 0 && d.pilotSize <= 100000
        && d.goals is list && d.goals.size() <= 8
        && goalOk(d.goals, 0) && goalOk(d.goals, 1) && goalOk(d.goals, 2) && goalOk(d.goals, 3)
        && goalOk(d.goals, 4) && goalOk(d.goals, 5) && goalOk(d.goals, 6) && goalOk(d.goals, 7)
        && d.done is list && d.done.size() <= 100
        && d.summaryNote is string && d.summaryNote.size() <= 1000
        && d.updatedAt == request.time;
    }

    match /orgPilot/{orgId} {
      allow get, list: if isPlatformOwner();
      allow create, update: if isPlatformOwner() && validPilot(request.resource.data);
      allow delete: if false;
    }

    match /orgPilot/{orgId}/log/{entryId} {
      allow get, list: if isPlatformOwner();
      allow create: if isPlatformOwner()
        && request.resource.data.keys().hasOnly(['at', 'kind', 'text'])
        && request.resource.data.kind in ['note', 'call', 'email', 'meeting', 'decision', 'stage']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isPlatformOwner();
    }

    // ------------------------------------------------------------ tool roadmap
    // Public list of tools people can vote for. The vote COUNT lives on the tool
    // so everyone can see it, which means signed-in people have to be allowed to
    // change it: but only by exactly one, and only together with creating (or
    // deleting) their own vote document for that tool. That is how the count
    // stays honest without a server. One vote per person per tool is enforced by
    // the vote document's id (uid_toolId): it can only be created once. Voting
    // needs a verified email address so one email is one voter.
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function validTool(d) {
      return d.keys().hasOnly(['title', 'description', 'category', 'status', 'order', 'voteCount', 'launchUrl', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 240
        && d.category is string && d.category.size() <= 40
        && d.status in ['considering', 'planned', 'in_progress', 'released']
        && d.order is int && d.order >= 0 && d.order <= 10000
        && d.voteCount is int && d.voteCount >= 0
        && d.get('launchUrl', '') is string && d.get('launchUrl', '').size() <= 300
        && (d.get('launchUrl', '') == '' || d.launchUrl.matches('https://.*'))
        && d.updatedAt == request.time;
    }

    match /tools/{toolId} {
      allow get, list: if true;

      allow create: if isPlatformOwner()
        && validTool(request.resource.data)
        && request.resource.data.voteCount == 0
        && request.resource.data.createdAt == request.time;

      allow update: if (isPlatformOwner()
          && validTool(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt)
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount'])
          && (
            // +1: only for a verified person, only while the tool is open, and only if this person's vote document is created in the same batch
            (isVerifiedUser()
              && request.resource.data.voteCount == resource.data.voteCount + 1
              && resource.data.status in ['considering', 'planned', 'in_progress']
              && !exists(/databases/$(database)/documents/toolVotes/$(request.auth.uid + '_' + toolId))
              && existsAfter(/databases/$(database)/documents/toolVotes/$(request.auth.uid + '_' + toolId)))
            ||
            // -1: only if this person's vote document is deleted in the same batch
            (request.resource.data.voteCount == resource.data.voteCount - 1
              && request.resource.data.voteCount >= 0
              && exists(/databases/$(database)/documents/toolVotes/$(request.auth.uid + '_' + toolId))
              && !existsAfter(/databases/$(database)/documents/toolVotes/$(request.auth.uid + '_' + toolId)))
          ));

      allow delete: if isPlatformOwner();
    }

    // One document per person per tool they back. Private to that person and the owner
    // (the owner needs the emails of people who asked to be told about a launch).
    match /toolVotes/{voteId} {
      allow get, list: if isSignedIn() && (resource.data.uid == request.auth.uid || isPlatformOwner());

      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['uid', 'toolId', 'email', 'notify', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.toolId is string
        && voteId == request.auth.uid + '_' + request.resource.data.toolId
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.notify is bool
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/tools/$(request.resource.data.toolId)).data.status in ['considering', 'planned', 'in_progress']
        && getAfter(/databases/$(database)/documents/tools/$(request.resource.data.toolId)).data.voteCount
            == get(/databases/$(database)/documents/tools/$(request.resource.data.toolId)).data.voteCount + 1;

      // Changing your mind about the launch email.
      allow update: if isVerifiedUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notify'])
        && request.resource.data.notify is bool;

      // Withdrawing a vote also takes exactly one off the tool's count. Two
      // exceptions keep people able to withdraw (and to delete their account):
      // the tool no longer exists, or its count is already zero (and stays zero).
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/tools/$(resource.data.toolId))
          || getAfter(/databases/$(database)/documents/tools/$(resource.data.toolId)).data.voteCount
              == get(/databases/$(database)/documents/tools/$(resource.data.toolId)).data.voteCount - 1
          || (get(/databases/$(database)/documents/tools/$(resource.data.toolId)).data.voteCount == 0
              && getAfter(/databases/$(database)/documents/tools/$(resource.data.toolId)).data.voteCount == 0));
    }

    // At most one suggestion per person (the document id is their uid). The owner
    // reads them all, approves or rejects, and approved ones become tools.
    function validSuggestion(d) {
      return d.keys().hasOnly(['uid', 'email', 'text', 'status', 'createdAt'])
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email.lower()
        && d.text is string && d.text.size() >= 5 && d.text.size() <= 300
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    // ---------------------------------------------------------- saved tools
    // Work saved from the free interactive tools on www.productadvisory.co (the scorecard, AI use cases,
    // build/buy/partner, impact score), kept in the person's own account (my-tools.html). Private to its owner:
    // nobody else, including the platform owner, can read it. `data` is the tool's own share-link encoding.
    function validSavedTool(d) {
      return d.keys().hasOnly(['uid', 'tool', 'title', 'summary', 'data', 'createdAt', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.tool in ['scorecard', 'ai', 'bbp', 'impact']
        && d.title is string && d.title.size() <= 100
        && d.summary is string && d.summary.size() <= 200
        && d.data is string && d.data.size() >= 1 && d.data.size() <= 20000 && d.data.matches('^[A-Za-z0-9_-]+$')
        && d.updatedAt == request.time;
    }

    match /savedTools/{docId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && validSavedTool(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && validSavedTool(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /toolSuggestions/{uid} {
      allow get: if isSignedIn() && (uid == request.auth.uid || isPlatformOwner());
      allow list: if isPlatformOwner();

      allow create: if isVerifiedUser() && uid == request.auth.uid && validSuggestion(request.resource.data);

      allow update: if (isVerifiedUser() && uid == request.auth.uid && validSuggestion(request.resource.data))
        || (isPlatformOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedAt == request.time);

      // The owner can delete any; people can delete their own (for example when they delete their account).
      allow delete: if isPlatformOwner() || (isSignedIn() && uid == request.auth.uid);
    }
  }
}
