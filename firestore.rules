// Firestore rules for project product-advisory-lms.
//
// STATUS: checkpoint 7 of the company-accounts build. The newest parts are the
// activity log (orgs/{orgId}/audit), the private owner notes (orgPrivate), and
// "an archived company receives no new member data". They only take effect once
// this whole file is pasted into the console Rules tab and published. Update
// this status line when that is done.
//
// Editing this file does NOT change the live rules. Paste the whole file into
// the console Rules tab and click Publish, so the two stay identical. These
// rules are tested against the local Firestore emulator (see
// tests/firestore-rules.test.mjs).
//
// WHO CAN DO WHAT
//   Anyone signed in:   read/write/delete ONLY their own progress/{uid}.
//   Platform owner:     (an account with a platformAdmins/{uid} document,
//                       created by hand in the console) creates and edits
//                       companies, creates and revokes invites, reads every
//                       membership, and can end any membership. Nobody can
//                       delete a company.
//   Company admin:      (an ACTIVE membership with role "admin") reads their
//                       own company, creates and revokes its invites, reads
//                       its memberships, may change ONLY its focusAreas, and
//                       can end anyone's membership but its own (see memberships).
//   Invited person:     reads an invite if they know its secret link, then
//                       accepts it, which creates their own membership.
//   Active member:      writes their own shared record (orgs/{orgId}/members/
//                       {uid}) for their current company; company admins and
//                       the platform owner can read it, nobody else can.
//   Company focus list: a copy of the company's ranked focus areas that its
//                       active members can read (see orgFocus below).
//   Everything else is denied by default.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    function myMembership() {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data;
    }

    function isActiveAdminOf(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && myMembership().orgId == orgId
        && myMembership().role == 'admin'
        && myMembership().status == 'active';
    }

    // ---------------------------------------------------------------- progress
    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ----------------------------------------------------------- platformAdmins
    // Lets a signed-in person check whether THEIR OWN account is the platform
    // owner. Nobody can list these documents or write them from the app.
    match /platformAdmins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------------- orgs
    function validOrg(d) {
      return d.keys().hasOnly(['name', 'plan', 'seatLimit', 'focusAreas', 'notes',
          'contactName', 'contactEmail', 'contactPhone', 'billingAddress',
          'status', 'createdAt', 'createdBy', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.plan in ['flat', 'seat']
        && (d.seatLimit == null || (d.seatLimit is int && d.seatLimit >= 1 && d.seatLimit <= 100000))
        && d.focusAreas is list && d.focusAreas.size() <= 7
        && d.focusAreas.hasOnly(['discovery', 'strategy', 'prioritization', 'execution', 'stakeholder', 'aiIndividual', 'aiOrg'])
        && d.focusAreas.toSet().size() == d.focusAreas.size()
        && d.get('notes', '') is string && d.get('notes', '').size() <= 2000
        && d.get('contactName', '') is string && d.get('contactName', '').size() <= 100
        && d.get('contactEmail', '') is string && d.get('contactEmail', '').size() <= 254
        && d.get('contactPhone', '') is string && d.get('contactPhone', '').size() <= 40
        && d.get('billingAddress', '') is string && d.get('billingAddress', '').size() <= 500
        && d.status in ['active', 'archived'];
    }

    match /orgs/{orgId} {
      allow read: if isPlatformOwner() || isActiveAdminOf(orgId);
      allow create: if isPlatformOwner()
        && validOrg(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isPlatformOwner()
          && validOrg(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy)
        || (isActiveAdminOf(orgId)
          && validOrg(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['focusAreas', 'updatedAt']));
      allow delete: if false;
    }

    // ----------------------------------------------------------------- invites
    // The document id IS the secret token in the invite link. Anyone signed in
    // who knows a token can read that one invite (listing is not allowed).
    function validInvite(d) {
      return d.keys().hasOnly(['orgId', 'orgName', 'email', 'name', 'phone', 'role', 'status', 'createdAt', 'createdBy', 'expiresAt', 'usedBy', 'usedAt'])
        && d.get('name', '') is string && d.get('name', '').size() <= 100
        && d.get('phone', '') is string && d.get('phone', '').size() <= 40
        && d.orgId is string
        && d.orgName is string && d.orgName.size() > 0 && d.orgName.size() <= 100
        && d.email is string && d.email.size() > 0 && d.email.size() <= 254
        && d.role in ['member', 'admin']
        && d.status == 'open'
        && d.usedBy == null && d.usedAt == null
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt < request.time + duration.value(120, 'd');
    }

    match /invites/{token} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isPlatformOwner() || isActiveAdminOf(resource.data.orgId));

      allow create: if (isPlatformOwner() || isActiveAdminOf(request.resource.data.orgId))
        && validInvite(request.resource.data)
        && get(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)).data.status == 'active'
        && get(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)).data.name == request.resource.data.orgName;

      allow update: if isSignedIn() && (
        // 1. The owner or one of the company's admins revokes an open invite.
        ((isPlatformOwner() || isActiveAdminOf(resource.data.orgId))
          && resource.data.status == 'open'
          && request.resource.data.status == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        ||
        // 2. The person accepting it, in the same batch that creates their membership.
        (resource.data.status == 'open'
          && request.time < resource.data.expiresAt
          && request.resource.data.status == 'used'
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.usedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt'])
          && getAfter(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.inviteToken == token)
      );

      allow delete: if false;
    }

    // ------------------------------------------------------------- memberships
    // One document per person (their uid), holding their CURRENT company
    // membership. A removed member can join a new company by accepting a new
    // invite, which rewrites the document.
    function validJoin(d, uid) {
      return d.keys().hasOnly(['orgId', 'orgName', 'role', 'status', 'inviteToken', 'joinedAt', 'endedAt', 'email', 'displayName', 'phone'])
        && d.get('phone', '') is string && d.get('phone', '').size() <= 40
        && d.get('phone', '') == get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.get('phone', '')
        && d.orgId is string
        && d.orgName is string
        && d.role in ['member', 'admin']
        && d.status == 'active'
        && d.endedAt == null
        && d.joinedAt == request.time
        && d.inviteToken is string
        && d.email is string && d.email == request.auth.token.email.lower()
        && d.displayName is string && d.displayName.size() <= 100
        && get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.status == 'open'
        && get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.orgId == d.orgId
        && get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.orgName == d.orgName
        && get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.role == d.role
        && request.time < get(/databases/$(database)/documents/invites/$(d.inviteToken)).data.expiresAt
        && getAfter(/databases/$(database)/documents/invites/$(d.inviteToken)).data.status == 'used'
        && getAfter(/databases/$(database)/documents/invites/$(d.inviteToken)).data.usedBy == uid
        && get(/databases/$(database)/documents/orgs/$(d.orgId)).data.status == 'active';
    }

    match /memberships/{uid} {
      allow get: if isSignedIn()
        && (request.auth.uid == uid || isPlatformOwner() || isActiveAdminOf(resource.data.orgId));
      allow list: if isSignedIn() && (isPlatformOwner() || isActiveAdminOf(resource.data.orgId));

      allow create: if isSignedIn() && request.auth.uid == uid
        && validJoin(request.resource.data, uid);
      allow update: if isSignedIn() && request.auth.uid == uid
        && resource.data.status == 'removed'
        && validJoin(request.resource.data, uid);
      // When someone deletes their account they blank the name, email and phone
      // on their membership record. Nothing else about it may change.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'phone'])
        && request.resource.data.email == ''
        && request.resource.data.displayName == ''
        && request.resource.data.get('phone', '') == '';
      // A membership is ended by the company, never by the member: the platform
      // owner or one of the company's admins can end anyone's membership but their
      // own. Only the status and end date change, so the person's record of who they
      // were and when they joined stays exactly as it was. From then on they can no
      // longer add to the company's copy of their results (see the shared-record
      // rules below), and they keep their own account, results and course access.
      allow update: if isSignedIn() && request.auth.uid != uid
        && (isPlatformOwner() || isActiveAdminOf(resource.data.orgId))
        && resource.data.status == 'active'
        && request.resource.data.status == 'removed'
        && request.resource.data.endedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt']);
      allow delete: if false;
    }

    // ------------------------------------------------- shared record per member
    // orgs/{orgId}/members/{uid} is the copy of a member's results that their
    // company can see. It holds ONLY: name and email, the latest assessment
    // (scores and individual answers), per-course lesson progress, and when
    // they were last active. It never holds private reflections, saved
    // templates, phone number or profile details.
    //
    // The member writes it, and only while their membership in THIS company is
    // active. When the membership ends, nothing can update it any more, so the
    // company keeps it exactly as it was. The only later change allowed is the
    // person blanking their own name and email (identity = null) when they
    // delete their account.
    function isActiveMemberOf(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && myMembership().orgId == orgId
        && myMembership().status == 'active';
    }

    function validShare(d) {
      return d.keys().hasOnly(['identity', 'assessment', 'courses', 'lastActiveAt', 'updatedAt'])
        && d.identity is map
        && d.identity.keys().hasOnly(['name', 'email'])
        && d.identity.name is string && d.identity.name.size() <= 100
        && d.identity.email is string && d.identity.email == request.auth.token.email.lower()
        && (d.assessment == null || d.assessment is map)
        && d.courses is map
        && (d.lastActiveAt == null || (d.lastActiveAt is string && d.lastActiveAt.size() <= 40))
        && d.updatedAt == request.time;
    }

    match /orgs/{orgId}/members/{uid} {
      // The company's admins and the platform owner can read it. The person
      // can read their OWN record too, so the app can show them exactly what
      // their company sees.
      allow read: if isPlatformOwner() || isActiveAdminOf(orgId)
        || (isSignedIn() && request.auth.uid == uid);

      // An archived company (for example one that has stopped paying) receives
      // nothing new: members' copies stop updating, exactly as if they had left.
      allow create, update: if request.auth.uid == uid
        && isActiveMemberOf(orgId)
        && get(/databases/$(database)/documents/orgs/$(orgId)).data.status == 'active'
        && validShare(request.resource.data);

      allow update: if request.auth.uid == uid
        && request.resource.data.identity == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['identity', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ------------------------------------------------------ company focus list
    // The company's ranked focus areas, copied from orgs/{orgId}.focusAreas into a
    // document that its ACTIVE MEMBERS may read (members cannot read the company
    // record itself, which holds contacts, billing and notes). The learner
    // dashboard uses it only to break ties between equally good recommendations.
    // It can only be written together with the company record: the rule below
    // refuses any copy that does not match the company's own list.
    match /orgFocus/{orgId} {
      allow get: if isPlatformOwner() || isActiveAdminOf(orgId) || isActiveMemberOf(orgId);

      allow create, update: if (isPlatformOwner() || isActiveAdminOf(orgId))
        && request.resource.data.keys().hasOnly(['focusAreas', 'updatedAt'])
        && request.resource.data.focusAreas is list
        && request.resource.data.focusAreas.size() <= 7
        && request.resource.data.focusAreas.hasOnly(['discovery', 'strategy', 'prioritization', 'execution', 'stakeholder', 'aiIndividual', 'aiOrg'])
        && request.resource.data.focusAreas.toSet().size() == request.resource.data.focusAreas.size()
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/orgs/$(orgId)).data.focusAreas == request.resource.data.focusAreas;

      allow delete: if false;
    }

    // ------------------------------------------------------------ activity log
    // A record of what the company's admins and the platform owner did: invites
    // created or withdrawn, people removed, priorities changed, details edited.
    // Entries are added by the person who did it (they cannot sign as somebody
    // else), carry the server's time, and can never be changed or deleted. The
    // company's admins and the owner read it; members cannot. It is kept by the
    // app on a best-effort basis, so it is an accountability aid, not a
    // tamper-proof legal record.
    match /orgs/{orgId}/audit/{entryId} {
      allow read: if isPlatformOwner() || isActiveAdminOf(orgId);
      allow create: if (isPlatformOwner() || isActiveAdminOf(orgId))
        && request.resource.data.keys().hasOnly(['action', 'actorUid', 'actorEmail', 'targetEmail', 'detail', 'at'])
        && request.resource.data.action in ['company.created', 'company.edited', 'company.archived', 'company.restored',
            'invite.created', 'invite.revoked', 'invite.renewed', 'member.removed', 'focus.changed']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email.lower()
        && request.resource.data.get('targetEmail', '') is string && request.resource.data.get('targetEmail', '').size() <= 254
        && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 300
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // --------------------------------------------------- owner-only company notes
    // The platform owner's private notes about a company. They used to live on the
    // company record itself, which that company's admins can read, so they are
    // kept here where only the platform owner can.
    match /orgPrivate/{orgId} {
      allow get, list: if isPlatformOwner();
      allow create, update: if isPlatformOwner()
        && request.resource.data.keys().hasOnly(['notes', 'updatedAt'])
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
